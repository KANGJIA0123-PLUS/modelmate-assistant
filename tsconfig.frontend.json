{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "public/api.js"
  ],
  "exclude": [
    "node_modules",
    "data",
    "artifacts",
    "supabase",
    "knowledge",
    "repos"
  ]
}
