{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/types/**/*.ts",
    "test/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "public",
    "data",
    "artifacts",
    "supabase",
    "knowledge",
    "repos"
  ]
}
