{
  "host": "0.0.0.0",
  "port": 4878,
  "claudePath": "claude",
  "claudeBare": true,
  "workingDirectory": "/knowledge/default",
  "questionLogPath": "/app/data/question-log.jsonl",
  "retrievalMode": "claude-tools",
  "model": "",
