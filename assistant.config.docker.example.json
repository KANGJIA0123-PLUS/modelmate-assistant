      "workingDirectory": "/knowledge/default",
      "sourceDirs": [
        "/knowledge/default",
        "/repos/default"
      ],
      "status": "active",
      "tags": [
        "docker",
        "default"
      ]
    }
  ],
  "allowedTools": [
    "Read",
    "Glob",
    "Grep",
    "LS"
  ],
  "disallowedTools": [
    "Edit",
    "MultiEdit",
    "Write",
    "NotebookEdit",
    "Bash",
    "WebFetch",
    "WebSearch"
  ],
  "queue": {
    "implementationStatus": "implemented",
    "maxConcurrent": 1,
    "maxQueueSize": 20,
    "perOperatorPerMinute": 20,
    "perIpPerMinute": 60,
    "jobTimeoutMs": 600000,
    "queueTimeoutMs": 120000
  },
  "historyStore": {
    "enabled": true,
    "dbPath": "/app/data/assistant.sqlite",
    "jsonlPath": "/app/data/question-log.jsonl",
    "retentionDays": 180
