{
  "host": "127.0.0.1",
  "port": 4878,
  "claudePath": "claude",
  "claudePathByPlatform": {
    "darwin": "claude",
    "linux": "claude",
    "win32": "claude.cmd"
  },
  "workingDirectory": ".",
  "questionLogPath": "data/question-log.jsonl",
  "sourceDirs": [
    "."
  ],
  "retrievalMode": "claude-tools",
  "model": "",
  "maxTurns": 1,
  "maxBudgetUsd": 0.2,
  "timeoutMs": 600000,
  "contextMaxChars": 8000,
  "historyMaxMessages": 8,
  "historyMaxChars": 6000,
  "searchMaxMatches": 80,
  "defaultVersionId": "default",
  "versions": [
    {
      "id": "default",
      "name": "默认版本",
      "description": "当前项目和资料目录。复制配置后可改成真实业务版本，例如 v2.3、v2.4。",
      "workingDirectory": ".",
      "sourceDirs": [
        "."
      ],
      "status": "active",
      "tags": [
        "local",
        "demo"
      ]
    }
  ],
  "allowedTools": [
    "Read",
    "Glob",
    "Grep",
    "LS"
  ],
  "disallowedTools": [
    "Edit",
    "MultiEdit",
    "Write",
    "NotebookEdit",
    "Bash",
    "WebFetch",
    "WebSearch"
  ],
  "queue": {
    "maxConcurrent": 1,
    "maxQueueSize": 20,
    "perOperatorPerMinute": 20,
    "perIpPerMinute": 60,
    "jobTimeoutMs": 600000,
    "queueTimeoutMs": 120000
  },
  "historyStore": {
    "enabled": false,
    "dbPath": "data/assistant.sqlite",
    "jsonlPath": "data/question-log.jsonl",
    "retentionDays": 180
  },
  "telemetry": {
    "enabled": false,
    "serviceName": "modelmate-assistant",
    "otlpEndpoint": "",
    "exportProtocol": "http/protobuf",
    "enableClaudeTelemetry": false,
    "logPromptContent": false,
    "logToolContent": false
  },
  "skills": {
    "enabled": true,
    "faqDirectAnswerEnabled": false,
    "minFaqHitCount": 3,
    "cacheTtlMs": 3600000
  },
  "systemPrompt": "你是现网接口人的只读知识助手。内部现网、接口、配置、日志、代码、流程类问题要优先查证当前版本的本地资料、Markdown 文档和代码仓。若当前版本资料没有命中，且问题属于通用知识、公开背景或概念解释，可以使用模型通用知识回答，并友好提示来源边界。若问题强时效、高风险或明确要求只基于当前版本资料，则不要凭空下结论，要提示补充资料或核验。不要修改、创建、删除任何文件。"
}
